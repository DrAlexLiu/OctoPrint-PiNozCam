


{% macro helpbtn(help_id) -%}
<a class="text-info pinozcam-help-icon" href="javascript:void(0)"
   data-help="{{ help_id }}" aria-expanded="false" aria-controls="{{ help_id }}"
   aria-label="{{ _('Explain this setting') }}"><i
   class="fas fa-info-circle" aria-hidden="true"></i></a>
{%- endmacro %}


{% macro shell(label, help_id, control, error_for=None, link=None,
               field_id=None, state=None, result=None) -%}

<div class="control-group"{% if state %}
     data-bind="css: {success: {{ state }}Ok, error: {{ state }}Bad}"{% endif %}>
    <label class="control-label"{% if field_id %} for="{{ field_id }}"{% endif %}>
        {%- if link %}<a href="{{ link }}" target="_blank"
           rel="noopener noreferrer">{{ label }}</a>
        {%- else %}{{ label }}{% endif -%}
    </label>
    <div class="controls">
        <div class="pinozcam-row">
            {{ control }}
            {{ helpbtn(help_id) }}
        </div>
        {%- if error_for %}
        <div class="pinozcam-field-error"
             data-bind="visible: {{ error_for }}.error, text: {{ error_for }}.error"></div>
        {%- endif %}
        {%- if result %}
        <span class="help-block" data-bind="visible: {{ result }}, text: {{ result }}"></span>
        {%- endif %}
        <div class="help-block pinozcam-help-text" id="{{ help_id }}" hidden>{{ caller() }}</div>
    </div>
</div>
{%- endmacro %}






{% macro number(label, bind, help_id, min=None, max=None, step=None, link=None,
              field_prefix='settings-pinozcam-') -%}
{%- set attrs = [] -%}
{%- if min is not none %}{% set _ = attrs.append("min: '%s'" % min) %}{% endif -%}
{%- if max is not none %}{% set _ = attrs.append("max: '%s'" % max) %}{% endif -%}
{%- if step is not none %}{% set _ = attrs.append("step: '%s'" % step) %}{% endif -%}
{%- set field_id = field_prefix ~ bind -%}
{%- set control -%}
<input type="number" id="{{ field_id }}" class="pinozcam-control text-right"
       data-bind="value: {{ bind }}, attr: {{ '{' }}{{ attrs|join(', ') }}{{ '}' }}"/>
{%- endset -%}
{%- set helptext = caller() -%}
{% call shell(label, help_id, control, error_for=bind, link=link,
              field_id=field_id) %}{{ helptext }}{% endcall %}
{%- endmacro %}


{% macro testbtn(click, label=None) -%}
<button type="button" class="btn add-on"
        data-bind="click: {{ click }}, css: {disabled: {{ click }}Busy}"><i
        class="fas fa-spinner fa-spin"
        data-bind="visible: {{ click }}Busy"></i> {{ label or _('Test') }}</button>
{%- endmacro %}


{% macro text(label, bind, help_id, link=None, test=None, error_for=None,
              inputmode=None) -%}
{%- set field_id = 'settings-pinozcam-' ~ bind -%}
{%- set control -%}
{%- if test %}

<span class="input-append pinozcam-append">
    <input type="text" id="{{ field_id }}" class="input-block-level"
           {% if inputmode %}inputmode="{{ inputmode }}" {% endif %}
           data-bind="value: {{ bind }}, valueUpdate: 'input'"/>
    {{- testbtn(test) }}
</span>
{%- else %}

<input type="text" id="{{ field_id }}" class="input-block-level"
       {% if inputmode %}inputmode="{{ inputmode }}" {% endif %}
       data-bind="value: {{ bind }}, valueUpdate: 'input'"/>
{%- endif %}
{%- endset -%}
{%- set helptext = caller() -%}
{% call shell(label, help_id, control, error_for=error_for,
              link=link, field_id=field_id,
              state=test, result=(test ~ 'Result') if test else None) %}{{ helptext }}{% endcall %}
{%- endmacro %}


{% macro select(label, bind, help_id, options, link=None, test=None,
                test_label=None) -%}
{%- set field_id = 'settings-pinozcam-' ~ bind -%}
{%- set menu -%}
<select id="{{ field_id }}" class="pinozcam-control"
        data-bind="value: {{ bind }}">
{%- for value, text in options %}
    <option value="{{ value }}">{{ text }}</option>
{%- endfor %}
</select>
{%- endset -%}
{%- set control -%}
{%- if test %}
<span class="input-append pinozcam-append pinozcam-append-fixed">
    {{- menu }}
    {{- testbtn(test, test_label) }}
</span>
{%- else %}{{ menu }}{% endif %}
{%- endset -%}
{%- set helptext = caller() -%}
{% call shell(label, help_id, control, link=link, field_id=field_id,
              state=test, result=(test ~ 'Result') if test else None) %}{{ helptext }}{% endcall %}
{%- endmacro %}


{% macro checkbox(label, bind, help_id=None) -%}
{%- set field_id = 'settings-pinozcam-' ~ bind -%}
<div class="control-group">
    <div class="controls">
        <label class="checkbox" for="{{ field_id }}">
            <input type="checkbox" id="{{ field_id }}"
                   data-bind="checked: {{ bind }}"> {{ label }}
        </label>
        {%- if help_id %} {{ helpbtn(help_id) }}
        <div class="help-block pinozcam-help-text" id="{{ help_id }}" hidden>{{ caller() }}</div>
        {%- endif %}
    </div>
</div>
{%- endmacro %}



{% macro sensitivity_help() -%}
Five steps from strict to loose &mdash; how strict the criteria are before
PiNozCam calls something a failure. These hardware names are suggested
starting points, not requirements:
<ul>
  <li><strong>1 Strictest</strong> &mdash; GPU or NPU</li>
  <li><strong>2 Strict</strong> &mdash; Raspberry Pi 5</li>
  <li><strong>3 Medium</strong> &mdash; Raspberry Pi 4</li>
  <li><strong>4 Loose</strong> &mdash; Raspberry Pi 3</li>
  <li><strong>5 Loosest</strong> &mdash; Raspberry Pi 2-class CPU</li>
</ul>
For tuning, keep <strong>Action on Failure</strong> at
<strong>Alert only</strong>, start at Loosest, and move left toward
Strictest until missed failures and false alerts reach the balance you want.
Only then consider allowing Pause or Stop.
<br><br>
The slider changes three values: minimum detection score, failure area, and
the fraction of recent frames that must be alarming. It does <strong>not</strong>
change Black Box Length; that has the same 120-second default at every
level. Editing any linked value changes the label to <strong>Custom</strong>
rather than claiming a preset it no longer matches.
{%- endmacro %}

{% macro slider(label, bind, help_id, steps, label_bind,
                field_prefix='settings-pinozcam-') -%}
{%- set field_id = field_prefix ~ bind -%}
{%- set control -%}
<span class="pinozcam-slider">
    <span class="pinozcam-slider-track">
        <span class="pinozcam-slider-rail" aria-hidden="true"></span>
        <span class="pinozcam-slider-dots" aria-hidden="true">
        {%- for i in range(steps) %}
            <span></span>
        {%- endfor %}
        </span>
        <input type="range" id="{{ field_id }}" class="pinozcam-range"
               min="1" max="{{ steps }}" step="1"
               data-bind="value: {{ bind }}, valueUpdate: 'input'"/>
    </span>
    <span class="pinozcam-slider-value" data-bind="text: {{ label_bind }}"></span>
</span>
{%- endset -%}
{%- set helptext = caller() -%}
{% call shell(label, help_id, control, field_id=field_id) %}{{ helptext }}{% endcall %}
{%- endmacro %}


{% macro action(label, help_id, click, text_bind, fallback, state=None,
                result=None, disabled=None) -%}
{%- set control -%}

<button type="button" class="btn"
        data-bind="click: {{ click }},
                   css: {disabled: {{ click }}Busy(){% if disabled %} || {{ disabled }}{% endif %}},
                   disable: {{ click }}Busy(){% if disabled %} || {{ disabled }}{% endif %}"><i
        class="fas fa-spinner fa-spin"
        data-bind="visible: {{ click }}Busy"></i> <span
        data-bind="text: {{ text_bind }}">{{ fallback }}</span></button>
{%- endset -%}
{%- set helptext = caller() -%}
{% call shell(label, help_id, control, state=state, result=result) %}{{ helptext }}{% endcall %}
{%- endmacro %}


{% macro section(title, note=None) -%}
<h3>{{ title }}</h3>
{%- if note %}
<p>{{ note }}</p>
{%- endif %}
{%- endmacro %}
