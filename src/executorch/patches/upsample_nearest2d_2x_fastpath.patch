+  // ---- Fast path: exact 2x upsample, contiguous NCHW ----------------------
+  // The generic loop below recomputes
+  //   min((int64_t)floor(dst * scale), size - 1)
+  // for BOTH axes on EVERY output element, and in_h does not even depend on w
+  // yet sits in the innermost loop. On 32-bit ARM the int64 arithmetic is a
+  // multi-instruction sequence, which makes this pathological: measured on a
+  // CM4 (A72, armv7l) two production 2x upsample operations cost 31.1 ms,
+  // versus 3.7 ms for the loop below (8.5x). On aarch64 the gap is
+  // only 2.0x, and on x86_64 18x (but sub-ms in absolute terms).
+  //
+  // For scale == 0.5 exactly, src_index(0.5, h, IH) = min(h >> 1, IH - 1),
+  // and since h < OH == 2*IH we have h >> 1 < IH, so the min() is a no-op:
+  // ih == h >> 1. So this path is **bit-identical**, not an approximation
+  // (verified with memcmp over the production tensor shapes).
+  //
+  // Strategy: expand each source row once along W, then memcpy that output
+  // row to produce its duplicate. No index arithmetic at all.
+  const auto IH = in.size(2), IW = in.size(3);
+  const auto OH = out.size(2), OW = out.size(3);
+  if (OH == 2 * IH && OW == 2 * IW && in.strides()[3] == 1 &&
+      in.strides()[2] == IW) {
+    const auto in_plane_stride = in.strides()[1];
+    const auto out_plane = OH * OW;
+    for (auto nc = 0; nc < out.size(0) * out.size(1); nc++) {
+      const CTYPE* ip = in_data + nc * in_plane_stride;
+      CTYPE* op = out_data + nc * out_plane;
+      for (auto ih = 0; ih < IH; ih++) {
+        const CTYPE* srow = ip + ih * IW;
+        CTYPE* drow = op + 2 * ih * OW;
+        for (auto iw = 0; iw < IW; iw++) {
+          const CTYPE v = srow[iw];
+          drow[2 * iw] = v;
+          drow[2 * iw + 1] = v;
+        }
+        memcpy(drow + OW, drow, OW * sizeof(CTYPE));
+      }
+    }
+    return;
+  }
